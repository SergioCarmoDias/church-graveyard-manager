{
  "name": "church-graveyard-manager",
  "version": "1.1.0",
  "description": "Cemetery mapping and record management app",
  "author": {
    "name": "Sergio C. D.",
    "email": "st.sergiocarmodias@gmail.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.cemetery.app",
    "productName": "Cemetery Mapping App",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "SergioCarmoDias",
      "repo": "church-graveyard-manager"
    },
    "win": {
      "target": "nsis",
      "icon": "logo.ico"
    },
    "files": [
      "main.js",
      "renderer.js",
      "index.html",
      "splash.html",
      "logo-animation.mp4",
      "logo.ico",
      "logo.png",
      "cemetery-map.svg",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
